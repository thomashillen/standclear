+            map.descendants(matching: .any).matching(NSPredicate(format: "label IN %@", labels)).allElementsBoundByIndex
+        } : []
+        let matched: [[String: String]] = elements.enumerated().map { index, element in
+            ["label": read("endpoint.\(index).label") { element.label },
+             "identifier": read("endpoint.\(index).identifier") { element.identifier },
+             "frame": read("endpoint.\(index).frame") { String(describing: element.frame) }]
+        }
+        let window = app.windows.firstMatch
+        let windowExists = read("window.exists") { window.exists }
+        let windowFrame = windowExists ? read("window.frame") { String(describing: window.frame) } : "unavailable"
+        let details: [String: Any] = [
+            "postDeadlineStartUTC": postStart,
+            "postDeadlineEndUTC": Date.now.timeIntervalSince1970,
+            "originalWaitResult": String(describing: result),
+            "mapExists": mapExists, "mapFrame": mapFrame, "mapValue": mapValue,
+            "clearButtonExists": clearExists, "clearButtonFrame": clearFrame,
+            "windowFrame": windowFrame, "matchedEndpoints": matched,
+            "expectedRemovedLabels": labels,
+        ]
+        if let data = try? JSONSerialization.data(withJSONObject: details, options: [.prettyPrinted, .sortedKeys]) {
+            let attachment = XCTAttachment(data: data, uniformTypeIdentifier: "public.json")
+            attachment.name = "Endpoint clear — POST deadline native observations"
+            attachment.lifetime = .keepAlways; add(attachment)
+        }
+        let hierarchy = XCTAttachment(string: read("app.debugDescription") { app.debugDescription })
+        hierarchy.name = "Endpoint clear — POST deadline accessibility hierarchy"
+        hierarchy.lifetime = .keepAlways; add(hierarchy)
+        if let data = try? JSONSerialization.data(withJSONObject: observations, options: [.prettyPrinted, .sortedKeys]) {
+            let attachment = XCTAttachment(data: data, uniformTypeIdentifier: "public.json")
+            attachment.name = "Endpoint clear — complete observation timestamps including POST deadline"
+            attachment.lifetime = .keepAlways; add(attachment)
+        }
+        XCTAssertEqual(result, .completed,
                        "Clear route must remove the boarding, arrival, and transfer markers", file: file, line: line)
     }
 
