+
+@MainActor
+enum NavigationDiagnostic {
+    static let enabled = ProcessInfo.processInfo.arguments.contains("--ui-test-navigation-diagnostic") && ProcessInfo.processInfo.arguments.contains("--ui-test-fixture")
+    static let originalBindings = ProcessInfo.processInfo.arguments.contains("--ui-test-navigation-original-bindings")
+    private struct Event: Codable {
+        let sequence: Int
+        let utcSeconds: Double
+        let uptime: Double
+        let event: String
+        let fields: [String: String]
+    }
+
+    private static var events: [Event] = []
+    static func record(_ event: String, _ fields: [String: String]) {
+        guard enabled else { return }
+        var fields = fields
+        fields["bindingMode"] = originalBindings ? "original" : "wrapped"
+        events.append(Event(sequence: events.count, utcSeconds: Date.now.timeIntervalSince1970,
+                            uptime: ProcessInfo.processInfo.systemUptime, event: event, fields: fields))
+    }
+
+    static func flush() {
+        guard enabled else { return }
+        let url = FileManager.default.urls(for: .documentDirectory, in: .userDomainMask)[0].appendingPathComponent("navigation-diagnostic-\(originalBindings ? "original" : "wrapped").json")
+        do {
+            let encoder = JSONEncoder()
+            encoder.outputFormatting = [.prettyPrinted, .sortedKeys]
+            try encoder.encode(events).write(to: url, options: .atomic)
+        } catch { print("Navigation diagnostic export failed") }
+    }
+}
