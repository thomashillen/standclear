+import { fireEvent, render, screen } from "@testing-library/react";
+import { readFileSync } from "node:fs";
+import { describe, expect, it, vi } from "vitest";
+
+import { CompactControlHitArea } from "./SearchSheet";
+
+const searchSheetSource = readFileSync("components/SearchSheet.tsx", "utf8");
+
+describe("SearchSheet compact control touch targets", () => {
+  it("provides an accessibility-hidden 44px hit area whose click bubbles to its button", () => {
+    const onClick = vi.fn();
+    render(
+      <button type="button" aria-label="Compact control" onClick={onClick}>
+        <CompactControlHitArea />
+      </button>,
+    );
+
+    const button = screen.getByRole("button", { name: "Compact control" });
+    const hitArea = button.querySelector("[data-compact-control-hit-area]");
+
+    expect(hitArea).not.toBeNull();
+    expect(hitArea?.getAttribute("aria-hidden")).toBe("true");
+    expect(hitArea?.className).toContain("h-11");
+    expect(hitArea?.className).toContain("w-11");
+    expect(screen.getAllByRole("button")).toHaveLength(1);
+
+    fireEvent.click(hitArea!);
+    expect(onClick).toHaveBeenCalledOnce();
+  });
+
+  it("adds the hit area to all four compact controls without enlarging their visible boxes", () => {
+    expect(
+      searchSheetSource.match(/<CompactControlHitArea \/>/g),
+    ).toHaveLength(4);
+
+    expect(searchSheetSource).toMatch(
+      /aria-label=\{\s*expandedPlan[\s\S]*?className="press relative w-8 h-8[\s\S]*?<CompactControlHitArea \/>/,
+    );
+    expect(searchSheetSource).toMatch(
+      /aria-label="Close panel"[\s\S]*?<CompactControlHitArea \/>/,
+    );
+    expect(searchSheetSource).toMatch(
+      /aria-label="Clear search"[\s\S]*?w-7 h-7[\s\S]*?<CompactControlHitArea \/>/,
+    );
+    expect(searchSheetSource).toMatch(
+      /aria-label="Swap from and to"[\s\S]*?w-9 h-9[\s\S]*?<CompactControlHitArea \/>/,
+    );
+  });
+
+  it("contains the clear-search target within the 44px input and reserves its text space", () => {
+    expect(searchSheetSource).toMatch(
+      /<div className="relative">[\s\S]*?className="w-full h-11 pl-10 pr-11[\s\S]*?aria-label="Clear search"[\s\S]*?absolute right-2 top-1\/2 -translate-y-1\/2 w-7 h-7[\s\S]*?<CompactControlHitArea \/>/,
+    );
+  });
+});
