+/**
+ * Invisible hit slop for compact controls whose visible box must not affect
+ * the sheet's layout. The span remains hidden from the accessibility tree and
+ * lets pointer events bubble to the existing button, so the button keeps its
+ * name, focus behavior, and click handler.
+ */
+export function CompactControlHitArea() {
+  return (
+    <span
+      aria-hidden="true"
+      data-compact-control-hit-area
+      className="absolute left-1/2 top-1/2 z-10 h-11 w-11 -translate-x-1/2 -translate-y-1/2"
+    />
+  );
+}
